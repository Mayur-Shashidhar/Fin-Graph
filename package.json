{
  "name": "fingraph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/demo.mjs",
    "setup": "node scripts/setup.mjs",
    "stack": "docker compose --env-file .env.local up --build -d --wait",
    "stack:stop": "docker compose --env-file .env.local stop",
    "database:init": "node --conditions=react-server --import tsx scripts/initialize.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "graph:setup": "node --conditions=react-server --import tsx scripts/graph.ts setup",
    "graph:sync": "node --conditions=react-server --import tsx scripts/graph.ts sync",
    "graph:worker": "node --conditions=react-server --import tsx scripts/graph.ts worker",
    "graph:status": "node --conditions=react-server --import tsx scripts/graph.ts status",
    "graph:retry": "node --conditions=react-server --import tsx scripts/graph.ts retry",
    "graph:reconcile": "node --conditions=react-server --import tsx scripts/graph.ts reconcile",
    "graph:detect": "node --conditions=react-server --import tsx scripts/graph.ts detect"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^1.61.0",
    "neo4j-driver": "^6.2.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
