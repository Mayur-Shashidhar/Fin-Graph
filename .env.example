# FinGraph Environment Variables Configuration
# Copy this file to .env.local for local development

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fingraph_db"

# Node Environment
NODE_ENV="development"

# Neo4j 5.26+ Community/Enterprise or Aura (server-side only)
NEO4J_URI="neo4j://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="replace-with-your-neo4j-password"
NEO4J_DATABASE="neo4j"

# Operator authorization for graph data, sync and detection endpoints.
# Generate a random secret of at least 32 characters; never use NEXT_PUBLIC_.
GRAPH_API_TOKEN=""

# Needed by the optional Docker Compose stack (must match DATABASE_URL password)
POSTGRES_PASSWORD="postgres"
# Set the browser-facing origin when using a reverse proxy or Docker
APP_URL="http://localhost:3000"
